digraph UML { graph [rankdir=TB, nodesep=.5, ranksep=.8]; node [shape=record, fontname="Arial", fontsize=10]; edge [fontname="Arial",fontsize=9]; E [label="{«interface» FileSystemElement|+ accept(visitor): void\l+ containsDirectory(target): boolean\l}"]; V [label="{«interface» FileSystemVisitor|+ visitFile(file): void\l+ visitDirectory(directory): void\l}"]; F [label="{FileElement|- name: String\l- sizeBytes: long\l|+ accept(visitor): void\l+ getName(): String\l+ getSizeBytes(): long\l}"]; D [label="{DirectoryElement|- name: String\l- children: List<FileSystemElement>\l|+ add(child): void\l+ accept(visitor): void\l+ getChildren(): List\l}"]; S [label="{SizeCalculatorVisitor|- totalBytes: long\l|+ visitFile(file): void\l+ visitDirectory(directory): void\l+ getTotalBytes(): long\l}"]; Q [label="{SearchVisitor|- query: String\l- matches: List<String>\l|+ visitFile(file): void\l+ visitDirectory(directory): void\l+ getMatches(): List\l}"]; F -> E [arrowhead=empty,style=dashed]; D -> E [arrowhead=empty,style=dashed]; S -> V [arrowhead=empty,style=dashed]; Q -> V [arrowhead=empty,style=dashed]; D -> E [label="children 0..*",arrowhead=odiamond, constraint=false]; E -> V [label="accept",style=dotted]; V -> F [label="visitFile",style=dotted]; V -> D [label="visitDirectory",style=dotted]; }